<?xml version="1.0" encoding="utf-8"?>
<!--
  광고 푸시 펼침(확장) 커스텀 레이아웃.
  DecoratedCustomViewStyle 로 시스템 헤더(앱이름·시간)는 유지되고,
  이 뷰는 본문 영역에 들어간다. 제목/본문 + 수신거부 행으로 구성.
  텍스트는 알림 테마에 맞춰지는 Compat Notification text appearance 사용.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/notifly_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notifly_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="6"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/notifly_image"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- RemoteViews 는 기본 View 태그를 인플레이트 못하므로 ImageView 로 구분선을 그린다 -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:alpha="0.2"
        android:background="?android:attr/textColorSecondary"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/notifly_unsubscribe_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_notifly_unsubscribe"
            android:tint="?android:attr/textColorSecondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="수신거부"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_notifly_arrow_right"
            android:tint="?android:attr/textColorSecondary" />
    </LinearLayout>
</LinearLayout>
